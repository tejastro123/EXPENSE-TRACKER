# ==============================================================================
# ExpenseFlow X - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME=ExpenseFlow X
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# API Gateway
# ------------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_WORKERS=4
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# Auth Service
# ------------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:8001
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# MFA
TOTP_SECRET_KEY=your-totp-secret-key
MFA_ISSUER=ExpenseFlowX

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://expenseflow:password@postgres:5432/expenseflowx
DATABASE_SYNC_URL=postgresql://expenseflow:password@postgres:5432/expenseflowx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=expenseflowx
POSTGRES_USER=expenseflow
POSTGRES_PASSWORD=your-strong-postgres-password
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://:your-redis-password@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# Celery
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://:your-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:your-redis-password@redis:6379/2
CELERY_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# AI / ML
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone (Vector DB)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=expenseflow-knowledge

# Hugging Face (for local models)
HF_TOKEN=your-huggingface-token
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# AI Service
AI_SERVICE_URL=http://ai-service:8004
RAG_TOP_K=5
FRAUD_THRESHOLD=0.85
PREDICTION_HORIZON_DAYS=30

# ------------------------------------------------------------------------------
# Notification Service
# ------------------------------------------------------------------------------
NOTIFICATION_SERVICE_URL=http://notification-service:8005

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@expenseflowx.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/serviceAccountKey.json

# ------------------------------------------------------------------------------
# Analytics Service
# ------------------------------------------------------------------------------
ANALYTICS_SERVICE_URL=http://analytics-service:8003

# ------------------------------------------------------------------------------
# Banking Integrations
# ------------------------------------------------------------------------------
# Plaid
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# ------------------------------------------------------------------------------
# Monitoring & Observability
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=expenseflowx-receipts
S3_BUCKET_URL=https://expenseflowx-receipts.s3.amazonaws.com

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded==
CSRF_SECRET=your-csrf-secret
SECURE_COOKIES=false  # Set to true in production (requires HTTPS)
SESSION_SECRET=your-session-secret

# Admin
ADMIN_SECRET_KEY=your-admin-secret-key
SUPER_ADMIN_EMAIL=admin@expenseflowx.com

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
FEATURE_FRAUD_DETECTION=true
FEATURE_AI_COPILOT=true
FEATURE_INVESTMENT_TRACKING=true
FEATURE_BANKING_SYNC=false
FEATURE_MFA=true
FEATURE_RAG_KNOWLEDGE=true
